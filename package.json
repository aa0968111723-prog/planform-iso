{
  "name": "planform-iso",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "3D 等角實尺場佈工具 — Vite + TypeScript + Three.js PWA",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "test:e2e": "playwright test"
  },
  "license": "MIT",
  "dependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
